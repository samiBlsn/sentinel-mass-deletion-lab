{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "workspace": {
            "type": "String"
        }
    },
    "resources": [
        {
            "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/4a71a7d4-77ab-4e56-a7e2-0e1c5116d49d')]",
            "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/4a71a7d4-77ab-4e56-a7e2-0e1c5116d49d')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
            "kind": "Scheduled",
            "apiVersion": "2023-12-01-preview",
            "properties": {
                "displayName": "Mass Azure Resource Group Deletion",
                "description": "Detects an identity deleting at least five Azure resource groups within a short time window.",
                "severity": "High",
                "enabled": false,
                "query": "AzureActivity\r\n| where OperationNameValue =~ \"MICROSOFT.RESOURCES/SUBSCRIPTIONS/RESOURCEGROUPS/DELETE\"\r\n| where ActivityStatusValue =~ \"Success\"\r\n| summarize\r\n    DeletedResourceGroupCount = dcount(ResourceGroup),\r\n    DeletedResourceGroups = make_set(ResourceGroup, 100),\r\n    FirstDeletion = min(TimeGenerated),\r\n    LastDeletion = max(TimeGenerated),\r\n    CallerIpAddress = take_any(CallerIpAddress)\r\n    by Caller\r\n| where DeletedResourceGroupCount >= 5",
                "queryFrequency": "PT5M",
                "queryPeriod": "PT5H",
                "triggerOperator": "GreaterThan",
                "triggerThreshold": 0,
                "suppressionDuration": "PT5H",
                "suppressionEnabled": false,
                "startTimeUtc": null,
                "tactics": [
                    "Impact"
                ],
                "techniques": [
                    "T1485"
                ],
                "subTechniques": [],
                "alertRuleTemplateName": null,
                "incidentConfiguration": {
                    "createIncident": true,
                    "groupingConfiguration": {
                        "enabled": false,
                        "reopenClosedIncident": false,
                        "lookbackDuration": "PT5H",
                        "matchingMethod": "AllEntities",
                        "groupByEntities": [],
                        "groupByAlertDetails": [],
                        "groupByCustomDetails": []
                    }
                },
                "eventGroupingSettings": {
                    "aggregationKind": "SingleAlert"
                },
                "alertDetailsOverride": null,
                "customDetails": {
                    "DeletedRGCount": "DeletedResourceGroupCount",
                    "DeletedRGs": "DeletedResourceGroups"
                },
                "entityMappings": [
                    {
                        "entityType": "Account",
                        "fieldMappings": [
                            {
                                "identifier": "FullName",
                                "columnName": "Caller"
                            }
                        ]
                    },
                    {
                        "entityType": "IP",
                        "fieldMappings": [
                            {
                                "identifier": "Address",
                                "columnName": "CallerIpAddress"
                            }
                        ]
                    }
                ],
                "sentinelEntitiesMappings": null,
                "templateVersion": null
            }
        }
    ]
}